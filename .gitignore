# win11-ai-orchestrator - Git Ignore Stricto
# Bloqueo de Datos Sensibles y Basura Técnica

# Datos y Bases de Datos
**/DataBases/
**/*.db
**/*.sqlite
**/*.vector
**/*.rag_cache/
**/*.chroma/

# Secretos y Configuración Local
.env
.env.local
.env.*.local
**/*.xml
**/*.json
!package.json
!tsconfig.json
!composer.json
!requirements.json
!settings.json.example

# Basura de Python/Node
__pycache__/
*.py[cod]
*$py.class
node_modules/
dist/
build/
.conda/
.venv/

# Logs y Temporales
*.log
**/logs/
.gemini_temp/
.qwen/
.vscode/

# Ecosistema (Protección de Origen)
**/Config/PowerShell/backups/
**/Config/env-vars/
